{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ch.master/1 — single timing source; frames @ fps",
  "type": "object",
  "required": ["schema", "id", "title", "fps", "width", "height", "durationFrames", "mode",
               "voice", "words", "segments", "audio"],
  "properties": {
    "schema": { "const": "ch.master/1" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "fps": { "enum": [24, 30] },
    "width": { "const": 1080 },
    "height": { "const": 1920 },
    "durationFrames": { "type": "integer", "minimum": 1 },
    "mode": { "enum": ["A", "B"] },
    "voice": {
      "type": "object",
      "required": ["file", "voiceId", "speed"],
      "properties": {
        "file": { "type": "string" },
        "voiceId": { "type": "string" },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2 }
      }
    },
    "words": {
      "type": "object",
      "required": ["pluginFile", "framesFile"],
      "properties": {
        "pluginFile": { "type": "string" },
        "framesFile": { "type": "string" }
      }
    },
    "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" } },
    "overlays": { "type": "array", "items": { "$ref": "#/$defs/overlay" } },
    "captions": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "style": { "type": "string" },
        "maxWords": { "type": "integer", "minimum": 1, "maximum": 5 },
        "safe": {
          "type": "object",
          "properties": {
            "top": { "type": "integer" },
            "bottom": { "type": "integer" },
            "side": { "type": "integer" }
          }
        }
      }
    },
    "audio": { "$ref": "#/$defs/audio" },
    "attributions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "frames": { "type": "integer", "minimum": 0 },
    "segment": {
      "type": "object",
      "required": ["id", "type", "startFrame", "endFrame"],
      "properties": {
        "id": { "type": "string", "pattern": "^seg[0-9]+$|^r[0-9]+$" },
        "type": { "enum": ["plugin", "remotion"] },
        "startFrame": { "$ref": "#/$defs/frames" },
        "endFrame": { "$ref": "#/$defs/frames" },
        "line": { "type": "string" },
        "transitionIn": {
          "type": "object",
          "properties": {
            "type": { "enum": ["cut", "fade", "dip", "wipe", "zoom", "flash"] },
            "frames": { "type": "integer", "minimum": 0, "maximum": 45 }
          }
        },
        "plugin": {
          "type": "object",
          "required": ["clip", "clipOffsetFrames", "shotIds"],
          "properties": {
            "clip": { "type": "string" },
            "clipOffsetFrames": { "$ref": "#/$defs/frames" },
            "shotIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "remotion": {
          "type": "object",
          "required": ["component", "props"],
          "properties": {
            "component": { "type": "string" },
            "props": { "type": "object" },
            "assets": { "type": "array", "items": { "type": "string" } },
            "hideCaptions": { "type": "boolean" }
          }
        }
      }
    },
    "overlay": {
      "type": "object",
      "required": ["id", "kind", "startFrame", "endFrame"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["hookText", "lowerThird", "logoBug", "sourceTag", "progressBar", "endCard",
                            "receiptTicker", "takeStamp", "qcSeal"] },
        "startFrame": { "$ref": "#/$defs/frames" },
        "endFrame": { "$ref": "#/$defs/frames" },
        "props": { "type": "object" }
      }
    },
    "audio": {
      "type": "object",
      "required": ["mixFile", "loudnessTarget", "cues"],
      "properties": {
        "mixFile": { "type": "string" },
        "loudnessTarget": { "type": "number" },
        "music": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["trackId", "startFrame", "endFrame"],
            "properties": {
              "trackId": { "type": "string" },
              "startFrame": { "$ref": "#/$defs/frames" },
              "endFrame": { "$ref": "#/$defs/frames" },
              "gainDb": { "type": "number" }
            }
          }
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "frame", "sfxId"],
            "properties": {
              "id": { "type": "string" },
              "frame": { "$ref": "#/$defs/frames" },
              "sfxId": { "type": "string" },
              "gainDb": { "type": "number" },
              "segmentId": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
